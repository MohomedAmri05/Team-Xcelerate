# ---------------------------------------------------------------------------
# High Street — environment configuration
# Copy this file to ".env" in the project root and fill in real values.
# Never commit ".env" or share it: it holds passwords and secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# --- Database (MySQL 8 or MariaDB 10.4+ / XAMPP) ---------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=high_street_db
DB_USER=root
DB_PASSWORD=
# Set to true for managed databases that require TLS (production only)
DB_SSL=false

# --- Authentication -------------------------------------------------------
# Use two different long random strings (e.g. 64 random characters each)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Account lockout: after this many wrong passwords in a row the account is
# locked for LOGIN_LOCK_MINUTES (an Admin can unlock it in Users).
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Test-drive staff availability: a Staff member is "Busy" when they already
# have a Pending/Confirmed test drive within this many minutes of the time.
TEST_DRIVE_SLOT_MINUTES=60

# "Forgot password?" links work once and expire after this many minutes.
# The link points to the first address in CLIENT_URL. Without SMTP the email
# is only printed in the API terminal ("Preview"), so the link can be copied
# from there during development.
PASSWORD_RESET_MINUTES=30

# --- Outgoing email (SMTP) ------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false and an
# App Password (Google account › Security › 2-Step Verification › App
# passwords). Never use the normal Gmail password.
# Leave SMTP_HOST empty in development: messages are then logged as
# "Preview" (NOT sent) and printed in the API terminal.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). false = STARTTLS upgrade (port 587)
SMTP_SECURE=false
# Force STARTTLS even if the server does not advertise it (optional)
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=

# Sender identity shown to recipients
MAIL_FROM_NAME=High Street
MAIL_FROM_ADDRESS=no-reply@highstreet.lk
# Older single-line format is still supported if the two lines above are empty:
# MAIL_FROM="High Street <no-reply@highstreet.lk>"

# Monitored mailbox that receives customer replies (Reply-To header)
MAIL_REPLY_TO=support@highstreet.lk
# Mailbox that receives staff notifications (new enquiries, bookings, complaints)
ADMIN_NOTIFICATION_EMAIL=

# --- Inbound email replies (optional) -------------------------------------
# Shared secret for POST /api/v1/inbound/email (provider webhook).
# Leave empty to disable the endpoint. See README › Email.
INBOUND_EMAIL_SECRET=

# --- Private document storage ---------------------------------------------
# Folder for uploaded customer documents (outside the public uploads folder).
# Relative paths are resolved from the server folder.
DOCUMENT_STORAGE_DIR=storage/documents
MAX_DOCUMENT_MB=8

# --- Demo data (npm run db:seed) ------------------------------------------
# Passwords for the demo admin@highstreet.lk / staff@highstreet.lk accounts.
# Leave empty and the seeder generates random ones and prints them once.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
# Password for customer@highstreet.lk created by db:seed:complaints
SEED_CUSTOMER_PASSWORD=

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
# Optional (put it in client/.env): Admin/Staff are signed out after this many
# minutes without activity (default 30, minimum 5).
# VITE_IDLE_MINUTES=30
